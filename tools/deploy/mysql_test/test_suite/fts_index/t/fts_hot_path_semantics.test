# Preserve tokenizer output, frequencies and scored/unscored retrieval semantics.
--disable_warnings
DROP DATABASE IF EXISTS fts_hot_path_semantics;
CREATE DATABASE fts_hot_path_semantics;
--enable_warnings
USE fts_hot_path_semantics;
SET NAMES utf8mb4;
SET ob_query_timeout = 10000000000;

# ASCII normalization, stopwords, repeated tokens and token-buffer lifetime.
SELECT TOKENIZE('lowercase lowerCASE lowerCASE THE the alpha beta alpha', 'beng', '[{"output":"all"}]');
SELECT TOKENIZE('cafe café cafe CAFÉ', 'beng', '[{"output":"all"}]');
SELECT TOKENIZE('alpha,beta;gamma!delta?echo-foxtrot_golf @hotel 123 42.5', 'beng', '[{"output":"all"}]');
SELECT TOKENIZE('ÉCOLE école Café café 你好 world 😀 WORLD', 'beng', '[{"output":"all"}]');
SELECT TOKENIZE('café CAFÉ the THE database' COLLATE utf8mb4_bin, 'beng', '[{"output":"all"}]');
SELECT TOKENIZE('', 'beng');
SELECT TOKENIZE('! @ # ...', 'beng');

# IK character categories and dictionary range boundaries, in both modes.
SELECT TOKENIZE('ＡＢＣ１２３ abc123 3.14 一百二十三公斤 日本語 カタカナ 한글 😀 数据库', 'ik', '[{"output":"all"}]');
SELECT TOKENIZE('一一对应 中文分词 数据库 海洋 龍 龙 龟 龠 龢 龥 龦', 'ik', '[{"output":"all"}]');
SELECT TOKENIZE('研究生命起源 南京市长江大桥 一百二十三公斤', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('研究生命起源 南京市长江大桥 一百二十三公斤', 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
# UTF-8 width boundaries, embedded NUL/control bytes and supplementary planes.
SELECT TOKENIZE(CONVERT(UNHEX('007F7FC280DFBFE0A080ED9FBFEE8080EFBFBFF0908080F48FBFBF') USING utf8mb4), 'ik', '[{"output":"all"}]');
SELECT TOKENIZE('ＡＺａｚ０９〇零一二三十百千万亿两αβéñ日本語한글𠀀😀', 'ik', '[{"output":"all"}]');
# Alternating default/custom configurations and parsers within one statement.
SELECT TOKENIZE('研究生命起源', 'ik'), TOKENIZE('alpha ALPHA café', 'beng'),
 TOKENIZE('研究生命起源', 'ik', '[{"additional_args":[{"ik_mode":"smart"}]}]');
PREPARE tp FROM 'SELECT TOKENIZE(?, ?, ?)';
SET @text = '研究生命起源 alpha ALPHA', @parser = 'ik', @options = '[]';
EXECUTE tp USING @text, @parser, @options;
SET @options = '[{"additional_args":[{"ik_mode":"smart"}]}]';
EXECUTE tp USING @text, @parser, @options;
SET @options = '[{"output":"invalid"}]';
--error ER_WRONG_ARGUMENTS
EXECUTE tp USING @text, @parser, @options;
SET @options = '[]';
EXECUTE tp USING @text, @parser, @options;
SET @parser = 'beng', @options = '[{"output":"all"}]';
EXECUTE tp USING @text, @parser, @options;
DEALLOCATE PREPARE tp;
SELECT TOKENIZE('中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，中文 abc123 全文索引，', 'ik', '[{"output":"all"}]');

CREATE TABLE docs (id INT PRIMARY KEY, body TEXT, FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO docs VALUES
 (1, 'alpha alpha database'), (2, 'beta database database'),
 (3, 'alpha beta database'), (4, 'gamma'), (5, ''), (6, NULL);
# Set membership is sufficient for these aggregates.
SELECT COUNT(*), SUM(id), MIN(id), MAX(id) FROM docs WHERE MATCH(body) AGAINST('alpha beta');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha alpha beta');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('notpresent');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('the about');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha beta') AND id > 1;
# Numeric score uses and Boolean mode must retain scoring and their filters.
SELECT COUNT(*), ROUND(SUM(MATCH(body) AGAINST('alpha beta')), 6) > 0 AS scored FROM docs WHERE MATCH(body) AGAINST('alpha beta');
# Numeric aggregate and nested score uses must not enter membership-only execution.
SELECT COUNT(*), ROUND(SUM(MATCH(body) AGAINST('alpha beta')), 8) AS total_score,
 ROUND(AVG(MATCH(body) AGAINST('alpha beta')), 8) AS mean_score
 FROM docs WHERE MATCH(body) AGAINST('alpha beta');
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha beta')
 HAVING SUM(MATCH(body) AGAINST('alpha beta')) > 0.5;
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha beta')
 AND MATCH(body) AGAINST('alpha beta') > 0.3;
SELECT COUNT(*) FROM (SELECT id, MATCH(body) AGAINST('alpha beta') AS score
 FROM docs WHERE MATCH(body) AGAINST('alpha beta')) scored_docs WHERE score > 0.3;
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha beta') > 0.1;
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha beta') < 100;
SELECT id, MATCH(body) AGAINST('alpha beta') > 0 AS scored FROM docs WHERE MATCH(body) AGAINST('alpha beta') ORDER BY MATCH(body) AGAINST('alpha beta') DESC, id;
SELECT id FROM docs WHERE MATCH(body) AGAINST('alpha beta') ORDER BY MATCH(body) AGAINST('alpha beta') DESC, id LIMIT 2;
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('+alpha -beta' IN BOOLEAN MODE);
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha beta' IN BOOLEAN MODE);
PREPARE p FROM 'SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST(?)';
SET @term = 'alpha';
EXECUTE p USING @term;
SET @term = 'beta';
EXECUTE p USING @term;
DEALLOCATE PREPARE p;
# Shared MATCH expression use through prepared-statement parameters still scores.
PREPARE p FROM 'SELECT COUNT(*), ROUND(SUM(MATCH(body) AGAINST(?)), 8) FROM docs WHERE MATCH(body) AGAINST(?)';
SET @term = 'alpha beta';
EXECUTE p USING @term, @term;
SET @term = 'alpha';
EXECUTE p USING @term, @term;
DEALLOCATE PREPARE p;
# Posting-list membership must follow transactional updates and rollback.
START TRANSACTION;
UPDATE docs SET body = 'alpha beta' WHERE id = 4;
DELETE FROM docs WHERE id = 1;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('alpha beta');
ROLLBACK;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('alpha beta');
CREATE FULLTEXT INDEX ft_ik ON docs(body) WITH PARSER ik;
SELECT COUNT(*), SUM(id) FROM docs WHERE MATCH(body) AGAINST('alpha beta');
CREATE TABLE binary_keys (id BINARY(16) PRIMARY KEY, body TEXT,
                         FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO binary_keys VALUES
 (UNHEX('00000000000000000000000000000000'), 'alpha beta'),
 (UNHEX('00000000000000000000000000000001'), 'beta gamma'),
 (UNHEX('00000000000000010000000000000000'), 'alpha gamma'),
 (UNHEX('7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF'), 'alpha beta gamma'),
 (UNHEX('80000000000000000000000000000000'), 'delta'),
 (UNHEX('FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF'), 'alpha beta gamma delta');
# Multi-list merge order, ties and index-back with binary keys containing NUL.
SELECT HEX(id) FROM binary_keys WHERE MATCH(body) AGAINST('alpha beta gamma') ORDER BY id;
SELECT HEX(id), ROUND(MATCH(body) AGAINST('alpha beta gamma'), 6) AS score
 FROM binary_keys WHERE MATCH(body) AGAINST('alpha beta gamma')
 ORDER BY MATCH(body) AGAINST('alpha beta gamma') DESC, id LIMIT 4;
SELECT COUNT(*) FROM binary_keys WHERE MATCH(body) AGAINST('+alpha -gamma' IN BOOLEAN MODE);
# Independent auxiliary builds can finish out of queue order, including normal indexes.
CREATE TABLE build_a (id INT PRIMARY KEY, body TEXT, n INT);
INSERT INTO build_a SELECT id, body, id FROM docs;
CREATE TABLE build_b LIKE build_a;
INSERT INTO build_b SELECT * FROM build_a;
CREATE TABLE build_c LIKE build_a;
INSERT INTO build_c SELECT * FROM build_a;
connect (build_a_conn, $OBMYSQL_MS0, root,,fts_hot_path_semantics,$OBMYSQL_PORT);
send CREATE FULLTEXT INDEX ft ON build_a(body) WITH PARSER ik;
connect (build_b_conn, $OBMYSQL_MS0, root,,fts_hot_path_semantics,$OBMYSQL_PORT);
send CREATE FULLTEXT INDEX ft ON build_b(body) WITH PARSER beng;
connection default;
CREATE INDEX ix_n ON build_c(n);
connection build_a_conn;
reap;
connection build_b_conn;
reap;
connection default;
SELECT id FROM build_a WHERE MATCH(body) AGAINST('alpha beta') ORDER BY id;
SELECT id, ROUND(MATCH(body) AGAINST('alpha beta'), 8) AS score FROM build_b
 WHERE MATCH(body) AGAINST('alpha beta') ORDER BY id;
SELECT id FROM build_c FORCE INDEX(ix_n) WHERE n BETWEEN 2 AND 4 ORDER BY id;
UPDATE build_a SET body = 'alpha beta' WHERE id = 4;
SELECT COUNT(*) FROM build_a WHERE MATCH(body) AGAINST('alpha beta');
disconnect build_a_conn;
disconnect build_b_conn;
DROP DATABASE fts_hot_path_semantics;
